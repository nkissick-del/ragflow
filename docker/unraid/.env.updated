# RAGFlow Unraid - Streamlined Stack (Postgres + Garage + Valkey)

# Vector Store (pgvector)
DOC_ENGINE=pgvector
# Note: Use the same credentials as the main app DB for simplicity, 
# or configure separately.
PGVECTOR_HOST=postgresql16
PGVECTOR_PORT=5432
PGVECTOR_DBNAME=ragflow_db
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=postgres

# Metadata / App Database (Postgres)
DB_TYPE=postgres
POSTGRES_HOST=postgresql16
POSTGRES_PORT=5432
POSTGRES_DBNAME=ragflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MAX_CONNECTIONS=100
STALE_TIMEOUT=30

# Object Storage (Garage - S3 Compatible)
# Set STORAGE_IMPL to AWS_S3 to use Garage
STORAGE_IMPL=AWS_S3
S3_ENDPOINT_URL=http://192.168.1.101:3900
S3_ACCESS_KEY=GK86ee02dcedc01254dfd9f09f
S3_SECRET_KEY=8f33f4e5a874fb1f5b88f445eb0353006996c7cbfb3cf7b4f98ce9111a180994
S3_REGION=default
S3_BUCKET=ragflow

# Cache (Valkey - External)
REDIS_HOST=192.168.1.101
REDIS_PORT=6379
REDIS_PASSWORD=

# RAGFlow Server
RAGFLOW_PROFILE=gpu
SVR_WEB_HTTP_PORT=6969
SVR_HTTP_PORT=9380
DEVICE=gpu
HF_ENDPOINT=https://hf-mirror.com
RAGFLOW_SECRET_KEY=5f4dcc3b5aa765d61d8327deb882cf995f4dcc3b5aa765d61d8327deb882cf99
RAGFLOW_MEM_LIMIT=8589934592

# Docling (GPU Accelerated)
# Pinned to v1.11.0 for reproducibility
# Digest: sha256:41d1d9f568dd67b2b31ac476a47f1c223c54b41ed5891c40ef2f4e2487e44762
DOCLING_IMAGE=ghcr.io/docling-project/docling-serve-cu126:v1.11.0
DOCLING_PORT=5001
DOCLING_SERVE_ENABLE_UI=1
DOCLING_SERVE_ALLOW_DOWNLOADS=1
DOCLING_SERVE_IMAGE_TO_TEXT_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct
DOCLING_SERVE_PICTURE_CLASSIFICATION_MODEL=ds4sd/DocumentFigureClassifier
DOCLING_MEM_LIMIT=4294967296
# DOCLING_BASE_URL should be the full URL (e.g., http://ragflow-docling:5001)
# or just the host (e.g., http://ragflow-docling) if the port is handled elsewhere.
DOCLING_BASE_URL=http://ragflow-docling:5001

# Global
PUID=99
PGID=100
COMPOSE_PROFILES=gpu,docling
TZ=Australia/Sydney
